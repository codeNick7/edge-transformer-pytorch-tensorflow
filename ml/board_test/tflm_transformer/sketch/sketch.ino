/*
 * The real edge transformer (1,155 params, TensorFlow/Keras -> float32 TFLite) on the
 * Arduino UNO Q MCU (STM32U585) with EloquentTinyML 3.0.1 + tflm_cortexm 1.0.0.
 * P0 Phase 4. model.h is generated by ml/board_test/make_transformer_header.py.
 *
 * Runs 8 real test rows (2 per class the model gets right + 2 it gets wrong) and checks the
 * board reproduces the Mac's TFLite output: same class (even for the wrong ones) and every
 * probability within PROB_TOLERANCE.
 *
 * Needs the same two local tflm_cortexm patches as the smoke test (docs/tflite-on-unoq-findings.md):
 * `typedef unsigned long ulong;` in system_setup.cpp and dot_a_linkage=false.
 */

#include "model.h"            // must come BEFORE <eloquent_tinyml.h>
#include <tflm_cortexm.h>
#include <eloquent_tinyml.h>
#include <Arduino_RouterBridge.h>

#define OUT Monitor
// Generous on purpose for the first run (the MCU has 786 KB RAM); minimise later.
#define ARENA_SIZE 32768
#define PROB_TOLERANCE 0.0001f

Eloquent::TF::Sequential<TF_NUM_OPS, ARENA_SIZE> tf;
bool ready = false;

void setup() {
  Bridge.begin();
  Monitor.begin();
  delay(3000);
  OUT.println("__TFLM TRANSFORMER TEST (UNO Q MCU)__");

  tf.setNumInputs(TF_NUM_INPUTS);
  tf.setNumOutputs(TF_NUM_OUTPUTS);
  REGISTER_MODEL_OPS(tf.resolver);  // each op once; list comes from model.h

  if (!tf.begin(transformerModel).isOk()) {
    OUT.print("begin() FAILED: ");
    OUT.println(tf.exception.toString());
    return;
  }
  ready = true;
  OUT.print("model loaded, ");
  OUT.print(transformerModelLen);
  OUT.println(" bytes");
}

void loop() {
  if (!ready) {
    OUT.println("not running: model failed to load (see message above)");
    delay(5000);
    return;
  }

  int passed = 0;
  unsigned long total_us = 0;
  for (int i = 0; i < N_SAMPLES; i++) {
    if (!tf.predict(SAMPLES[i]).isOk()) {
      OUT.print("sample ");
      OUT.print(i);
      OUT.print(": predict() FAILED: ");
      OUT.println(tf.exception.toString());
      continue;
    }
    total_us += tf.benchmark.microseconds();

    float max_dp = 0.0f;
    for (int c = 0; c < TF_NUM_OUTPUTS; c++) {
      float dp = fabsf(tf.output(c) - EXPECTED_PROB[i][c]);
      if (dp > max_dp) max_dp = dp;
    }
    bool ok = (tf.classification == EXPECTED_CLASS[i]) && (max_dp < PROB_TOLERANCE);
    if (ok) passed++;

    OUT.print("sample ");
    OUT.print(i);
    OUT.print(": true ");
    OUT.print(TRUE_CLASS[i]);
    OUT.print(", mac ");
    OUT.print(EXPECTED_CLASS[i]);
    OUT.print(", board ");
    OUT.print(tf.classification);
    OUT.print(", conf ");
    OUT.print(tf.output(tf.classification), 4);
    OUT.print(", max|dp| ");
    OUT.print(max_dp, 7);
    OUT.println(ok ? "  PASS" : "  FAIL");
  }

  OUT.print("RESULT: ");
  OUT.print(passed);
  OUT.print("/");
  OUT.print(N_SAMPLES);
  OUT.print(" PASS, ");
  OUT.print(total_us / (unsigned long)N_SAMPLES);
  OUT.println(" us per prediction");
  delay(5000);
}
