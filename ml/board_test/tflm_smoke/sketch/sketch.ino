/*
 * TFLite Micro smoke test for the Arduino UNO Q MCU (STM32U585, Cortex-M33).
 * P0 Phase 0, route A: Arduino Zephyr core 1.1.0 + EloquentTinyML 3.x + tflm_cortexm.
 *
 * Runs a 2,280-byte model (4 -> 16 ReLU -> 3 softmax, trained on the real soil
 * features) on 6 samples and compares each result with what TensorFlow Lite on the
 * Mac produced (model.h, generated by ml/board_test/make_smoke_model.py).
 *
 * Expected output, once per cycle:
 *   sample 0: expected 0, got 0, max|dp| 0.00000x  PASS
 *   ...
 *   RESULT: 6/6 PASS, <n> us per prediction
 *
 * Output goes to App Lab's console through the Bridge Monitor. If `Monitor` does not
 * compile on your setup, set USE_MONITOR to 0 to print over Serial instead.
 */

#define USE_MONITOR 1

#include "model.h"            // must come BEFORE <eloquent_tinyml.h>
#include <tflm_cortexm.h>     // Cortex-M runtime (NOT tflm_esp32.h)
#include <eloquent_tinyml.h>

#if USE_MONITOR
#include <Arduino_RouterBridge.h>
#define OUT Monitor
#else
#define OUT Serial
#endif

// Generous on purpose for a first run; shrink later once it works.
#define ARENA_SIZE 8192
#define PROB_TOLERANCE 0.001f

Eloquent::TF::Sequential<TF_NUM_OPS, ARENA_SIZE> tf;
bool ready = false;

void setup() {
#if USE_MONITOR
  Bridge.begin();
  Monitor.begin();
#else
  Serial.begin(115200);
#endif
  delay(3000);
  OUT.println("__TFLM SMOKE TEST (UNO Q MCU)__");

  tf.setNumInputs(TF_NUM_INPUTS);
  tf.setNumOutputs(TF_NUM_OUTPUTS);
  // Ops are registered by begin() from the TF_OP_* macros in model.h. Do NOT also call
  // tf.resolver.Add...() here: TFLM warns "Calling AddBuiltin with the same op more
  // than once" (seen on the board 2026-11-24 for ops #9 and #25).

  if (!tf.begin(smokeModel).isOk()) {
    OUT.print("begin() FAILED: ");
    OUT.println(tf.exception.toString());
    return;
  }
  ready = true;
  OUT.println("model loaded");
}

void loop() {
  if (!ready) {
    OUT.println("not running: model failed to load (see message above)");
    delay(5000);
    return;
  }

  int passed = 0;
  unsigned long total_us = 0;
  for (int i = 0; i < N_SAMPLES; i++) {
    if (!tf.predict(SAMPLES[i]).isOk()) {
      OUT.print("sample ");
      OUT.print(i);
      OUT.print(": predict() FAILED: ");
      OUT.println(tf.exception.toString());
      continue;
    }
    total_us += tf.benchmark.microseconds();

    float max_dp = 0.0f;
    for (int c = 0; c < TF_NUM_OUTPUTS; c++) {
      float dp = fabsf(tf.output(c) - EXPECTED_PROB[i][c]);
      if (dp > max_dp) max_dp = dp;
    }
    bool ok = (tf.classification == EXPECTED_CLASS[i]) && (max_dp < PROB_TOLERANCE);
    if (ok) passed++;

    OUT.print("sample ");
    OUT.print(i);
    OUT.print(": expected ");
    OUT.print(EXPECTED_CLASS[i]);
    OUT.print(", got ");
    OUT.print(tf.classification);
    OUT.print(", max|dp| ");
    OUT.print(max_dp, 6);
    OUT.println(ok ? "  PASS" : "  FAIL");
  }

  OUT.print("RESULT: ");
  OUT.print(passed);
  OUT.print("/");
  OUT.print(N_SAMPLES);
  OUT.print(" PASS, ");
  OUT.print(total_us / (unsigned long)N_SAMPLES);
  OUT.println(" us per prediction");
  delay(5000);
}
